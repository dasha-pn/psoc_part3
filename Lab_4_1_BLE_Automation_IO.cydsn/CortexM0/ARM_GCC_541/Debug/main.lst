 961:main.c        **** /*******************************************************************************
 962:main.c        **** * Function Name: LowPowerImplementation()
 963:main.c        **** ********************************************************************************
 964:main.c        **** * Summary:
 965:main.c        **** * Implements low power in the project.
 966:main.c        **** *
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccTXWGea.s 			page 60


 967:main.c        **** * Theory:
 968:main.c        **** * The function tries to enter deep sleep as much as possible - whenever the 
 969:main.c        **** * BLE is idle and the UART transmission/reception is not happening. At all other
 970:main.c        **** * times, the function tries to enter CPU sleep.
 971:main.c        **** *
 972:main.c        **** *******************************************************************************/
 973:main.c        **** static void LowPowerImplementation(void)
 974:main.c        **** {
 975:main.c        ****     CYBLE_LP_MODE_T bleMode;
 976:main.c        ****     uint8 interruptStatus;
 977:main.c        ****     
 978:main.c        ****     /* For advertising and connected states, implement deep sleep 
 979:main.c        ****      * functionality to achieve low power in the system. For more details
 980:main.c        ****      * on the low power implementation, refer to the Low Power Application 
 981:main.c        ****      * Note.
 982:main.c        ****      */
 983:main.c        ****     if(((CyBle_GetState() == CYBLE_STATE_ADVERTISING) || 
 984:main.c        ****         (CyBle_GetState() == CYBLE_STATE_CONNECTED)) &&
 985:main.c        ****         (CapSense_NOT_BUSY == CapSense_IsBusy()))
 986:main.c        ****     {
 987:main.c        ****         /* Request BLE subsystem to enter into Deep-Sleep mode between connection and advertising i
 988:main.c        ****         bleMode = CyBle_EnterLPM(CYBLE_BLESS_DEEPSLEEP);
 989:main.c        ****         /* Disable global interrupts */
 990:main.c        ****         interruptStatus = CyEnterCriticalSection();
 991:main.c        ****         /* When BLE subsystem has been put into Deep-Sleep mode */
 992:main.c        ****         if(bleMode == CYBLE_BLESS_DEEPSLEEP)
 993:main.c        ****         {
 994:main.c        ****             /* And it is still there or ECO is on */
 995:main.c        ****             if((CyBle_GetBleSsState() == CYBLE_BLESS_STATE_ECO_ON) || 
 996:main.c        ****                (CyBle_GetBleSsState() == CYBLE_BLESS_STATE_DEEPSLEEP))
 997:main.c        ****             {
 998:main.c        ****                 /* Put the CPU into the Deep-Sleep mode when all debug information has been sent */
 999:main.c        ****                 if((UART_DEB_GET_TX_BUFF_SIZE() + UART_DEB_GET_TX_FIFO_SR_VALID) == 0u)
1000:main.c        ****                 {
1001:main.c        ****                     CySysPmDeepSleep();
1002:main.c        ****                 }
1003:main.c        ****                 else /* Put the CPU into Sleep mode and let SCB to continue sending debug data */
1004:main.c        ****                 {
1005:main.c        ****                     CySysPmSleep();
1006:main.c        ****                 }
1007:main.c        ****             }
1008:main.c        ****         }
1009:main.c        ****         else /* When BLE subsystem has been put into Sleep mode or is active */
1010:main.c        ****         {
1011:main.c        ****             /* And hardware doesn't finish Tx/Rx operation - put the CPU into Sleep mode */
1012:main.c        ****             if(CyBle_GetBleSsState() != CYBLE_BLESS_STATE_EVENT_CLOSE)
1013:main.c        ****             {
1014:main.c        ****                 CySysPmSleep();
1015:main.c        ****             }
1016:main.c        ****         }
1017:main.c        ****         /* Enable global interrupt */
1018:main.c        ****         CyExitCriticalSection(interruptStatus);
1019:main.c        ****     }
1020:main.c        **** }
