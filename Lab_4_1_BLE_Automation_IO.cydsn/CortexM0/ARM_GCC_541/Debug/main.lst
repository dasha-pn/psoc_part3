 457:main.c        **** void AdcHandler(void)
 458:main.c        **** {
 459:main.c        ****     static uint16 prev_ADC_val = 0xFFFF;
 460:main.c        ****     static uint8 out_range_indic = 0;
 461:main.c        ****     uint16 curr_val;
 462:main.c        ****     uint8 outOfRange = 0;
 463:main.c        **** 
 464:main.c        ****     if(data_ready == 0)
 465:main.c        ****     {
 466:main.c        ****         return;
 467:main.c        ****     }
 468:main.c        ****     
 469:main.c        ****     data_ready = 0;
 470:main.c        ****     curr_val = adcResult;
 471:main.c        **** 
 472:main.c        ****     if((curr_val < ADC_VALID_RANGE_MIN) || (curr_val > ADC_VALID_RANGE_MAX))
 473:main.c        ****     {
 474:main.c        ****         outOfRange = 1;
 475:main.c        ****         DBG_PRINTF("ADC value out of range");
 476:main.c        ****     }
 477:main.c        **** 
 478:main.c        ****     if((uint16)abs(curr_val - prev_ADC_val) >= ADC_CHANGE_THRESHOLD)
 479:main.c        ****     {
 480:main.c        ****         prev_ADC_val = curr_val;
 481:main.c        **** 
 482:main.c        ****         out7seg(curr_val);
 483:main.c        ****         
 484:main.c        ****         apiResult = CyBle_AiossSetCharacteristicValue(
 485:main.c        ****             CYBLE_AIOS_ANALOG,
 486:main.c        ****             INSTANCE_ADC,
 487:main.c        ****             sizeof(curr_val),
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccTXWGea.s 			page 27


 488:main.c        ****             (uint8 *)&curr_val
 489:main.c        ****         );
 490:main.c        ****         
 491:main.c        ****         if(apiResult == CYBLE_ERROR_OK)
 492:main.c        ****         {
 493:main.c        ****             DBG_PRINTF("ADC = %d\r\n", curr_val);
 494:main.c        ****         }
 495:main.c        ****     }
 496:main.c        **** 
 497:main.c        ****     if(outOfRange && !out_range_indic)
 498:main.c        ****     {
 499:main.c        ****         out_range_indic = 1;
 500:main.c        ****         ADC_INDIC(curr_val);
 501:main.c        ****     }
 502:main.c        ****     else if(!outOfRange)
 503:main.c        ****     {
 504:main.c        ****         out_range_indic = 0;
 505:main.c        ****     }
 506:main.c        **** 
 507:main.c        ****     LED_D1_state_upd();
 508:main.c        **** }
